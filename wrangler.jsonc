{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posimulatore",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": ["/", "/wms/*", "/robots.txt", "/config", "/api/*"], "not_found_handling": "single-page-application" },
  "observability": { "enabled": true },
  // le variabili messe a mano nel pannello di Cloudflare (es. GOOGLE_TILES_KEY) restano dopo ogni pubblicazione
  "keep_vars": true,
  // utenti, punti di interesse corretti a mano e impostazioni per tutti; schema in migrations/
  "d1_databases": [{ "binding": "DB", "database_name": "posimulatore", "database_id": "cbd15589-f89b-416f-90b8-d2068c3e7372" }],
  // serve al comando `wrangler preview`, che Workers Builds lancia sui rami diversi da main
  "previews": {}
}
