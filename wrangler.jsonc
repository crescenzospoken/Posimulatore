{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posimulatore",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": ["/wms/*", "/robots.txt"], "not_found_handling": "single-page-application" },
  "observability": { "enabled": true }
}
