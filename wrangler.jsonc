{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posimulatore",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // tutto passa dal Worker: serve al 301 da workers.dev anche per i file statici (privacy, termini, codice)
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "observability": { "enabled": true },
  // dominio cre.cy (20/11/2026); HOST_CANONICO (vars) acceso il 21/11 dopo aver aggiunto posimulatore.cre.cy
  // alla chiave Google (referrer) e al token Cesium ion.
  "routes": [{ "pattern": "posimulatore.cre.cy", "custom_domain": true }],
  // referrer della chiave Google e token Cesium ion aggiornati da Crescenzo il 21/11: workers.dev ora rimanda qui (301)
  "vars": { "HOST_CANONICO": "posimulatore.cre.cy" },
  // con un dominio personalizzato wrangler spegne workers.dev se non lo si tiene acceso: serve acceso per il 301
  "workers_dev": true,
  // le variabili messe a mano nel pannello di Cloudflare (es. GOOGLE_TILES_KEY) restano dopo ogni pubblicazione
  "keep_vars": true,
  // utenti, punti di interesse corretti a mano e impostazioni per tutti; schema in migrations/
  "d1_databases": [{ "binding": "DB", "database_name": "posimulatore", "database_id": "cbd15589-f89b-416f-90b8-d2068c3e7372" }],
  // serve al comando `wrangler preview`, che Workers Builds lancia sui rami diversi da main
  "previews": {}
}
